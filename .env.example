# =============================================================================
#  Folafemz Global — Admin dashboard
# =============================================================================
#  Copy this file to `.env.local` and fill in the values. `.env.local` is
#  gitignored; this template is tracked and must never hold a real key.
#
#  Where each value comes from is noted above it. Anything prefixed with
#  NEXT_PUBLIC_ is compiled into the browser bundle and is readable by anyone
#  who loads the page — never put a secret behind that prefix.
# =============================================================================

# -----------------------------------------------------------------------------
#  Supabase — project connection
#  Supabase dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# "anon / public" key. Safe in the browser: it can only do what your Row Level
# Security policies allow, which is why the policies in supabase/schema.sql
# matter. Newer projects call this the publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "service_role" key. SECRET — bypasses Row Level Security completely.
# Server-side only. If this ever leaks, rotate it in the Supabase dashboard.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection strings. Supabase dashboard → Project Settings → Database
# → Connection string. Both contain the database password: treat as secrets.
#
# The app itself does not use these — it talks to Supabase over the REST API,
# so the two keys above are what it actually needs. These are for psql and any
# migration tooling.
#
# DATABASE_URL is the transaction-mode pooler on port 6543. It is IPv4-friendly
# and suits short-lived queries and serverless connections.
#
# DIRECT_URL is the session-mode pooler on port 5432. Use this one for
# migrations: transaction mode runs each statement on a different backend
# connection, which breaks session state, advisory locks and multi-statement
# DDL scripts such as supabase/schema.sql.
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------------
#  Supabase — storage
#  Supabase dashboard → Storage. Create the bucket, then name it here.
#  supabase/schema.sql creates this bucket for you if you run it.
# -----------------------------------------------------------------------------

# Bucket holding fleet photography, hero images and gallery media.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=media

# Largest upload accepted, in megabytes. Checked in the browser before the
# file is sent, again in the upload route, and once more by the storage bucket
# itself — which caps everything at 30MB, so raising the video figure above
# that has no effect without also raising the bucket in supabase/schema.sql.
#
# NEXT_PUBLIC_ because the browser reads them too, to reject an oversized file
# before spending someone's data allowance uploading it. They are only numbers.
NEXT_PUBLIC_UPLOAD_MAX_MB=1
NEXT_PUBLIC_VIDEO_MAX_MB=30

# -----------------------------------------------------------------------------
#  Admin access
# -----------------------------------------------------------------------------

# Comma-separated allowlist of addresses permitted to sign in. Leave empty to
# allow any user that exists in Supabase Auth. Creating users is done in the
# Supabase dashboard → Authentication → Users; there is deliberately no public
# sign-up route in this app.
ADMIN_ALLOWED_EMAILS=


# -----------------------------------------------------------------------------
#  Public website
#  The customer-facing site this dashboard administers.
# -----------------------------------------------------------------------------

# Live site origin, used for "view on site" links.
NEXT_PUBLIC_SITE_URL=https://folafemzglobal.com


# Deploy hook that rebuilds the public site after you publish content changes.
# Vercel → public site project → Settings → Git → Deploy Hooks.
# Leave empty to skip the rebuild and publish content only.
DEPLOY_HOOK_URL=
